rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'normal';
    }
    function admin() {
      return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /students/{studentId} {
      allow read: if active();
      allow write: if false;
      match /certificates/{certificateId} {
        allow read: if active();
        allow write: if false;
      }
    }
    match /{path=**}/certificates/{certificateId} {
      allow read: if active();
    }
    match /login_history/{historyId} {
      allow read: if admin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
